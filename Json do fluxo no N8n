        "jsCode": "// 1. Pega os clientes vindos do nó Webhook\nconst webhookData = $('Webhook').first().json;\nconst clientes = webhookData.body?.clientes || webhookData.clientes || [];\n\n// 2. Pega as opções de investimento do nó \"Extract from File\"\nconst investimentos = $('Extract from File').all().map(item => item.json);\n\n// 3. Cruza os dados e gera a mensagem de recomendação\nreturn clientes.map(cliente => {\n  const perfilCliente = (cliente.perfil || '').toLowerCase();\n\n  // Filtra os produtos adequados ao perfil do cliente\n  const recomendacoes = investimentos.filter(inv => {\n    const perfilInvestimento = (inv.perfil || inv.Perfil || '').toLowerCase();\n    return perfilInvestimento === perfilCliente;\n  });\n\n  // Monta a lista de produtos formatada para a mensagem\n  const listaProdutos = recomendacoes.map(p => \n    `- **${p.produto}**: Aporte mínimo de R$ ${p.minimo} com rentabilidade estimada de ${p.rentabilidade}`\n  ).join('\\n');\n\n  // Cria a mensagem personalizada\n  const mensagem = `Olá, ${cliente.nome}!\\n\\n` +\n    `Analisamos o seu perfil de investidor (${cliente.perfil}) e preparamos as melhores opções para o seu saldo disponível de R$ ${cliente.saldo}:\\n\\n` +\n    `${listaProdutos}\\n\\n` +\n    `Se tiver dúvidas, estamos à disposição para te ajudar a rentabilizar o seu patrimônio!`;\n\n  return {\n    json: {\n      nome: cliente.nome,\n      email: cliente.email,\n      saldo: cliente.saldo,\n      perfil: cliente.perfil,\n      recomendacoes: recomendacoes,\n      mensagem_recomendacao: mensagem\n    }\n  };\n});"
      },
